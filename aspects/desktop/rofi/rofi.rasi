/*
 * rofi window-switcher theme, rendered by matugen from DankMaterialShell's
 * Material You palette (the colors.<role> placeholders below are filled in by
 * DMS on every theme build). Output: ~/.local/share/rofi/themes/dms.rasi.
 *
 * No glass on purpose: niri's blur does not reach layer-shell surfaces, so the
 * panel is an opaque surface_container to keep text crisp.
 */
* {
    background-color: transparent;
    text-color: {{colors.on_surface.default.hex}};
    border: 0;
    margin: 0;
    padding: 0;
}

window {
    background-color: {{colors.surface_container.default.hex}};
    border: 1px;
    border-color: {{colors.outline_variant.default.hex}};
    border-radius: 16;
    padding: 10;
    width: 600;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 6;
}

inputbar {
    background-color: {{colors.surface_container_highest.default.hex}};
    border-radius: 12;
    padding: 10px 14px;
    spacing: 12;
    children: [ entry ];
}

prompt {
    enabled: false;
}

entry {
    placeholder: "Search windows";
    placeholder-color: {{colors.on_surface_variant.default.hex}};
}

listview {
    lines: 10;
    spacing: 2;
    padding: 2px 0 0 0;
    scrollbar: false;
    border: 0;
    dynamic: true;
}

element {
    padding: 9px 12px;
    border-radius: 10;
    spacing: 14;
}

element-icon {
    size: 1.2em;
    horizontal-align: 0;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0;
    text-color: {{colors.on_surface.default.hex}};
}

/* Selected row uses the M3 "selected container" pair, never a bright primary
 * fill behind light text. */
element selected {
    background-color: {{colors.primary_container.default.hex}};
    text-color: {{colors.on_primary_container.default.hex}};
}

element selected element-text {
    text-color: {{colors.on_primary_container.default.hex}};
}
